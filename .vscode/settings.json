{
  "codingcopilot.enableCompletionLanguage": {
    "sql": false
  },
  "[sql]": {
    "editor.defaultFormatter": "cweijan.vscode-mysql-client2",
    "editor.formatOnSave": true,
    "editor.quickSuggestions": {
      "other": false,
      "comments": true,
      "strings": true
    },
    "editor.suggestOnTriggerCharacters": false,
    "editor.wordBasedSuggestions": "off",
    "editor.inlineSuggest.enabled": false
  },
  "files.associations": {
    "*.sql": "mysql"
  },
  "cSpell.words": [
    "atguigudb"
  ],
  "sqltools.connections": [
    {
      "mysqlOptions": {
        "authProtocol": "default",
        "enableSsl": "Disabled"
      },
      "ssh": "Disabled",
      "previewLimit": 50,
      "server": "localhost",
      "port": 3306,
      "driver": "MySQL",
      "name": "MYSQL LESSON",
      "username": "root",
      "database": "atguigudb"
    }
  ]
}
